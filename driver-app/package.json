    "@capacitor/device": "^8.0.3",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
